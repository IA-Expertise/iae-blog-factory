---
import type { AdPosicao } from "@prisma/client";
import { bannerImageSrc } from "../lib/bannerImage";
import {
  countActiveInternalAds,
  pickAndRecordInternalAdImpression,
  pickRandomPlaceholder
} from "../lib/cms";

interface Props {
  hostname: string;
  posicao: AdPosicao;
  layout?: "card" | "banner";
  wrapFullBleedTop?: boolean;
  /** Índice do slot na mesma posição (0,1,2…): um criativo pago por slot; excesso → placeholder. */
  slotVariant?: number;
}

const { hostname, posicao, layout = "card", wrapFullBleedTop = false, slotVariant = 0 } = Astro.props;

const seedKey = `${hostname}:${posicao}`;
Astro.locals.adRotationSeeds ??= {};
if (Astro.locals.adRotationSeeds[seedKey] === undefined) {
  Astro.locals.adRotationSeeds[seedKey] = Math.floor(Math.random() * 1_000_000);
}
const rotationSeed = Astro.locals.adRotationSeeds[seedKey]!;

const internal = await pickAndRecordInternalAdImpression(hostname, posicao, slotVariant, rotationSeed);

let placeholder = null as Awaited<ReturnType<typeof pickRandomPlaceholder>>;
if (!internal) {
  const activePaid = await countActiveInternalAds(hostname, posicao);
  const leftoverIndex = activePaid > 0 ? Math.max(0, slotVariant - activePaid) : slotVariant;
  placeholder = await pickRandomPlaceholder(hostname, posicao, leftoverIndex, rotationSeed);
}

const isBanner = layout === "banner";
const hasBlock = Boolean(internal || placeholder);

const imgSrc = (url: string) => bannerImageSrc(url);
const bannerW = 728;
const bannerH = 110;
---

{
  wrapFullBleedTop && hasBlock && internal && (
    <div class="border-b pb-3" style="border-color: color-mix(in srgb, var(--color-text) 12%, transparent);">
      <div class="mx-auto min-w-0 max-w-7xl px-4 sm:px-6 lg:px-8">
        <aside
          class="min-w-0 border bg-[var(--color-surface)] shadow-sm w-full max-w-full rounded-none border-x-0 px-0 py-3 sm:rounded-2xl sm:border sm:px-4"
          style="border-color: color-mix(in srgb, var(--color-text) 16%, transparent);"
        >
          <p class="mb-2 px-1 text-xs uppercase tracking-wide sm:px-0" style="color: color-mix(in srgb, var(--color-text) 55%, transparent);">Publicidade</p>
          <div class="overflow-hidden rounded-none sm:rounded-xl" style="background: color-mix(in srgb, var(--color-surface) 88%, white);">
            <a href={`/api/ads/click?id=${internal.id}`} target="_blank" rel="noopener noreferrer sponsored" class="block">
              <img
                src={imgSrc(internal.imagemUrl)}
                alt=""
                class="h-auto w-full max-h-[110px] object-cover object-center"
                width={bannerW}
                height={bannerH}
                loading="lazy"
                decoding="async"
              />
            </a>
          </div>
        </aside>
      </div>
    </div>
  )
}

{
  wrapFullBleedTop && hasBlock && placeholder && (
    <div class="border-b pb-3" style="border-color: color-mix(in srgb, var(--color-text) 12%, transparent);">
      <div class="mx-auto min-w-0 max-w-7xl px-4 sm:px-6 lg:px-8">
        <aside
          class="min-w-0 border border-dashed bg-[var(--color-surface)] shadow-sm w-full max-w-full rounded-none border-x-0 px-0 py-3 opacity-95 sm:rounded-2xl sm:border sm:px-4"
          style="border-color: color-mix(in srgb, var(--color-text) 20%, transparent);"
        >
          <p class="mb-1 px-1 text-xs uppercase tracking-wide sm:px-0" style="color: color-mix(in srgb, var(--color-text) 55%, transparent);">Espaço patrocinado</p>
          <p class="mb-2 px-1 text-xs font-medium sm:px-0" style="color: color-mix(in srgb, var(--color-text) 70%, transparent);">{placeholder.titulo}</p>
          <div class="overflow-hidden rounded-none sm:rounded-xl" style="background: color-mix(in srgb, var(--color-surface) 88%, white);">
            {placeholder.ctaUrl ? (
              <a href={placeholder.ctaUrl} target="_blank" rel="noopener noreferrer" class="block">
                <img
                  src={imgSrc(placeholder.imagemUrl)}
                  alt={placeholder.titulo}
                  class="h-auto w-full max-h-[110px] object-cover object-center"
                  width={bannerW}
                  height={bannerH}
                  loading="lazy"
                  decoding="async"
                />
              </a>
            ) : (
              <img
                src={imgSrc(placeholder.imagemUrl)}
                alt={placeholder.titulo}
                class="h-auto w-full max-h-[110px] object-cover object-center"
                width={bannerW}
                height={bannerH}
                loading="lazy"
                decoding="async"
              />
            )}
          </div>
        </aside>
      </div>
    </div>
  )
}

{
  !wrapFullBleedTop && internal && (
    <aside
      class:list={[
        "min-w-0 border bg-[var(--color-surface)] shadow-sm",
        isBanner
          ? "w-full max-w-full rounded-none border-x-0 px-0 py-3 sm:rounded-2xl sm:border sm:px-4"
          : "w-full max-w-full rounded-2xl p-4"
      ]}
      style="border-color: color-mix(in srgb, var(--color-text) 16%, transparent);"
    >
      <p class="mb-2 text-xs uppercase tracking-wide px-1 sm:px-0" style="color: color-mix(in srgb, var(--color-text) 55%, transparent);">Publicidade</p>
      <div
        class:list={["overflow-hidden", isBanner ? "min-h-[110px] rounded-none sm:rounded-xl" : "rounded-xl"]}
        style="background: color-mix(in srgb, var(--color-surface) 88%, white);"
      >
        <a
          href={`/api/ads/click?id=${internal.id}`}
          target="_blank"
          rel="noopener noreferrer sponsored"
          class:list={["block", isBanner ? "" : "mx-auto max-w-[300px]"]}
        >
          <img
            src={imgSrc(internal.imagemUrl)}
            alt=""
            class:list={[
              isBanner ? "h-auto max-h-[110px] w-full object-cover object-center" : "h-auto w-full max-w-[300px] object-cover"
            ]}
            width={isBanner ? bannerW : 300}
            height={isBanner ? bannerH : 250}
            loading="lazy"
            decoding="async"
          />
        </a>
      </div>
    </aside>
  )
}

{
  !wrapFullBleedTop && !internal && placeholder && (
    <aside
      class:list={[
        "min-w-0 border border-dashed bg-[var(--color-surface)] shadow-sm opacity-95",
        isBanner
          ? "w-full max-w-full rounded-none border-x-0 px-0 py-3 sm:rounded-2xl sm:border sm:px-4"
          : "w-full max-w-full rounded-2xl p-4"
      ]}
      style="border-color: color-mix(in srgb, var(--color-text) 20%, transparent);"
    >
      <p class="mb-1 text-xs uppercase tracking-wide px-1 sm:px-0" style="color: color-mix(in srgb, var(--color-text) 55%, transparent);">Espaço patrocinado</p>
      <p class="mb-2 text-xs font-medium px-1 sm:px-0" style="color: color-mix(in srgb, var(--color-text) 70%, transparent);">{placeholder.titulo}</p>
      <div
        class:list={["overflow-hidden", isBanner ? "min-h-[110px] rounded-none sm:rounded-xl" : "rounded-xl"]}
        style="background: color-mix(in srgb, var(--color-surface) 88%, white);"
      >
        {placeholder.ctaUrl ? (
          <a
            href={placeholder.ctaUrl}
            target="_blank"
            rel="noopener noreferrer"
            class:list={["block", isBanner ? "" : "mx-auto max-w-[300px]"]}
          >
            <img
              src={imgSrc(placeholder.imagemUrl)}
              alt={placeholder.titulo}
              class:list={[
                isBanner ? "h-auto max-h-[110px] w-full object-cover object-center" : "h-auto w-full max-w-[300px] object-cover"
              ]}
              width={isBanner ? bannerW : 300}
              height={isBanner ? bannerH : 250}
              loading="lazy"
              decoding="async"
            />
          </a>
        ) : (
          <img
            src={imgSrc(placeholder.imagemUrl)}
            alt={placeholder.titulo}
            class:list={[
              isBanner ? "h-auto max-h-[110px] w-full object-cover object-center" : "mx-auto block h-auto max-w-[300px] object-cover"
            ]}
            width={isBanner ? bannerW : 300}
            height={isBanner ? bannerH : 250}
            loading="lazy"
            decoding="async"
          />
        )}
      </div>
    </aside>
  )
}
