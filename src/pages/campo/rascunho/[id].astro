---
import { canAccessCampo, getCampoTenantScope, isAdminAuthenticated } from "../../../lib/adminAuth";
import {
  getPostById,
  getTenantByHostname,
  publishPostNow,
  regeneratePostCover,
  updatePostFields
} from "../../../lib/cms";
import { resolvePublicOrigin } from "../../../lib/publicOrigin";
import { buildTenantPostPath as buildPath } from "../../../lib/tenantUrls";
import { renderPostMarkdown } from "../../../lib/renderMarkdown";
import { resolvePublicAssetUrl } from "../../../lib/mediaUrl";
import { normalizeSocialVideoInput, SOCIAL_VIDEO_HINT } from "../../../lib/socialVideoEmbed";
import SocialVideoEmbed from "../../../components/SocialVideoEmbed.astro";

export const prerender = false;

if (!canAccessCampo(Astro.cookies)) {
  return Astro.redirect("/admin/login?next=/campo");
}

const isAdmin = isAdminAuthenticated(Astro.cookies);
const editorScope = getCampoTenantScope(Astro.cookies);

const { id } = Astro.params;
if (!id) return Astro.redirect("/campo");

let flash = "";
let publishedUrl = "";
let coverFlash = "";
let saveFlash = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const action = String(form.get("action") ?? "");
  const existing = await getPostById(id);
  if (!existing) return Astro.redirect("/campo");
  if (editorScope && existing.tenant.hostname !== editorScope) {
    return Astro.redirect("/campo");
  }

  if (action === "save") {
    const video = normalizeSocialVideoInput(String(form.get("videoUrl") ?? ""));
    await updatePostFields(id, {
      title: String(form.get("title") ?? ""),
      category: String(form.get("category") ?? ""),
      excerpt: String(form.get("excerpt") ?? ""),
      content: String(form.get("content") ?? ""),
      videoUrl: video.error ? undefined : video.value
    });
    saveFlash = video.error ? "video" : "ok";
  }

  if (action === "approve") {
    // Salva edições pendentes do formulário antes de publicar (se vierem no POST).
    const title = String(form.get("title") ?? "").trim();
    if (title) {
      const video = normalizeSocialVideoInput(String(form.get("videoUrl") ?? ""));
      await updatePostFields(id, {
        title,
        category: String(form.get("category") ?? ""),
        excerpt: String(form.get("excerpt") ?? ""),
        content: String(form.get("content") ?? ""),
        videoUrl: video.error ? undefined : video.value
      });
    }
    await publishPostNow(id);
    const rowAfter = await getPostById(id);
    if (rowAfter) {
      const origin = resolvePublicOrigin(Astro.request.url, Astro.request);
      const host = rowAfter.tenant.hostname.trim().toLowerCase();
      const publicDomain =
        /^[a-z0-9-]+(\.[a-z0-9-]+)*\.[a-z]{2,}$/i.test(host) &&
        host !== "localhost" &&
        !host.endsWith(".local");
      const base = publicDomain ? `https://${host}` : origin;
      publishedUrl = new URL(buildPath(rowAfter.tenant.hostname, rowAfter.slug), `${base}/`).toString();
      flash = "published";
    }
  }

  if (action === "regenerate_cover") {
    const ok = await regeneratePostCover(id);
    coverFlash = ok ? "ok" : "fail";
  }
}

const row = await getPostById(id);
if (!row) return Astro.redirect("/campo");
if (editorScope && row.tenant.hostname !== editorScope) {
  return Astro.redirect("/campo");
}

const siteData = await getTenantByHostname(row.tenant.hostname);
const articleHtml = row.content ? renderPostMarkdown(row.content) : "";
const coverSrc = resolvePublicAssetUrl(row.image);
const isPublished = row.status === "PUBLISHED";
const coverStyle = siteData?.coverImageStyle || row.tenant.coverImageStyle || "photo";
const editMode = !isPublished;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Rascunho | {row.title}</title>
    <style>
      :root {
        --bg: #0f172a;
        --panel: #1e293b;
        --text: #f8fafc;
        --muted: #94a3b8;
        --accent: #38bdf8;
        --ok: #4ade80;
        --danger: #f87171;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        min-height: 100dvh;
        font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
        background: #0f172a;
        color: var(--text);
      }
      .wrap { max-width: 40rem; margin: 0 auto; padding: 1rem 1rem 8.5rem; }
      .banner {
        background: #422006;
        color: #fde68a;
        border-radius: 0.75rem;
        padding: 0.75rem 1rem;
        font-size: 0.875rem;
        margin-bottom: 1rem;
      }
      .banner.ok { background: #14532d; color: #bbf7d0; }
      .banner.err { background: #7f1d1d; color: #fecaca; }
      .meta { color: var(--muted); font-size: 0.8rem; margin-bottom: 0.5rem; }
      h1 { font-size: 1.6rem; line-height: 1.25; margin: 0 0 0.75rem; }
      .cover {
        width: 100%;
        max-height: 16rem;
        object-fit: cover;
        border-radius: 1rem;
        margin-bottom: 0.75rem;
      }
      label {
        display: block;
        font-size: 0.75rem;
        color: var(--muted);
        margin: 0.75rem 0 0.35rem;
      }
      input, textarea {
        width: 100%;
        border-radius: 0.75rem;
        border: 1px solid #475569;
        background: #1e293b;
        color: var(--text);
        padding: 0.75rem;
        font-size: 1rem;
        font-family: inherit;
      }
      textarea.content {
        min-height: 18rem;
        line-height: 1.55;
        resize: vertical;
      }
      textarea.excerpt { min-height: 4.5rem; resize: vertical; }
      .hint { font-size: 0.75rem; color: var(--muted); margin-top: 0.35rem; }
      .prose { line-height: 1.65; font-size: 1.05rem; color: #e2e8f0; }
      .prose :global(h2) { font-size: 1.25rem; margin-top: 1.5rem; }
      .prose :global(h3) { font-size: 1.1rem; margin-top: 1.25rem; }
      .prose :global(p) { margin: 0.75rem 0; }
      .prose :global(a) { color: var(--accent); }
      .bar {
        position: fixed;
        left: 0; right: 0; bottom: 0;
        background: rgba(15, 23, 42, 0.96);
        border-top: 1px solid #334155;
        padding: 0.75rem 1rem calc(0.75rem + env(safe-area-inset-bottom));
      }
      .bar-inner {
        max-width: 40rem;
        margin: 0 auto;
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
      }
      .bar a, .bar button {
        flex: 1;
        min-width: 28%;
        text-align: center;
        text-decoration: none;
        border: 0;
        border-radius: 0.75rem;
        padding: 0.85rem 0.5rem;
        font-weight: 600;
        font-size: 0.85rem;
        cursor: pointer;
      }
      .btn-ghost { background: #334155; color: #fff; }
      .btn-ai { background: #0c4a6e; color: #e0f2fe; }
      .btn-save { background: #475569; color: #fff; }
      .btn-ok { background: var(--ok); color: #052e16; }
      .topnav { display: flex; justify-content: space-between; margin-bottom: 0.75rem; }
      .topnav a { color: var(--accent); text-decoration: none; font-size: 0.85rem; }
    </style>
  </head>
  <body>
    <div class="wrap">
      <div class="topnav">
        <a href="/campo">← Novo envio</a>
        {isAdmin ? <a href={`/admin/post/${row.id}`}>Admin</a> : <a href="/admin/logout">Sair</a>}
      </div>

      {
        flash === "published" || isPublished ? (
          <div class="banner ok">
            Matéria publicada.
            {publishedUrl ? (
              <>
                {" "}
                <a href={publishedUrl} style="color:#bbf7d0;font-weight:600;">Abrir no site</a>
              </>
            ) : null}
          </div>
        ) : saveFlash === "ok" ? (
          <div class="banner ok">Alterações salvas. Continue revisando ou aprove para publicar.</div>
        ) : saveFlash === "video" ? (
          <div class="banner err">URL de vídeo não reconhecida. Os demais campos foram salvos.</div>
        ) : coverFlash === "ok" ? (
          <div class="banner ok">Capa regenerada com IA (estilo: {coverStyle}).</div>
        ) : coverFlash === "fail" ? (
          <div class="banner err">Não foi possível regenerar a capa. Tente de novo.</div>
        ) : (
          <div class="banner">Revise o texto, ajuste se precisar e aprove para publicar.</div>
        )
      }

      <p class="meta">
        Tenant: <strong style="color:#fff;">{siteData?.brandName ?? row.tenant.brandName}</strong>
        {" · "}
        {row.tenant.hostname}
        {" · "}
        Status: {row.status}
      </p>
      <p class="meta">estilo capa: {coverStyle}</p>

      {coverSrc ? <img class="cover" src={coverSrc} alt={row.title} /> : null}

      {
        editMode ? (
          <form id="edit-form" method="POST">
            <label for="title">Título</label>
            <input id="title" name="title" required value={row.title} />

            <label for="category">Categoria</label>
            <input
              id="category"
              name="category"
              list="campo-categories"
              value={row.category}
              placeholder="publieditorial"
            />
            <datalist id="campo-categories">
              <option value="publieditorial"></option>
              <option value="Local"></option>
              <option value="Cidade"></option>
              <option value="Campo"></option>
            </datalist>
            <p class="hint">
              Para sorteio no WhatsApp, a categoria precisa ser exatamente <strong>publieditorial</strong> (antes de publicar).
            </p>

            <label for="excerpt">Resumo (excerpt)</label>
            <textarea id="excerpt" class="excerpt" name="excerpt">{row.excerpt ?? ""}</textarea>

            <label for="videoUrl">URL do vídeo (opcional)</label>
            <input id="videoUrl" name="videoUrl" type="url" value={row.videoUrl ?? ""} placeholder="https://www.youtube.com/watch?v=…" />
            <p class="hint">{SOCIAL_VIDEO_HINT}</p>
            <SocialVideoEmbed url={row.videoUrl} />

            <label for="content">Texto da matéria (markdown)</label>
            <textarea id="content" class="content" name="content" required>{row.content ?? ""}</textarea>
            <p class="hint">Use ## para subtítulos. Salve antes de sair ou use Aprovar (salva e publica).</p>
          </form>
        ) : articleHtml ? (
          <>
            <h1>{row.title}</h1>
            <SocialVideoEmbed url={row.videoUrl} />
            <div class="prose" set:html={articleHtml} />
          </>
        ) : (
          <>
            <h1>{row.title}</h1>
            <SocialVideoEmbed url={row.videoUrl} />
            <p class="prose">{row.excerpt}</p>
          </>
        )
      }
    </div>

    {
      editMode ? (
        <div class="bar">
          <div class="bar-inner">
            <button class="btn-save" type="submit" form="edit-form" name="action" value="save">
              Salvar
            </button>
            <form method="POST" style="flex:1;display:flex;min-width:28%;">
              <input type="hidden" name="action" value="regenerate_cover" />
              <button class="btn-ai" type="submit" style="flex:1;">
                Nova capa
              </button>
            </form>
            <button class="btn-ok" type="submit" form="edit-form" name="action" value="approve">
              Aprovar
            </button>
          </div>
        </div>
      ) : (
        <div class="bar">
          <div class="bar-inner">
            <a class="btn-ok" href={publishedUrl || `/t/${encodeURIComponent(row.tenant.hostname)}/post/${encodeURIComponent(row.slug)}`}>
              Ver no site
            </a>
            <a class="btn-ghost" href="/campo">
              Novo envio
            </a>
          </div>
        </div>
      )
    }
  </body>
</html>
