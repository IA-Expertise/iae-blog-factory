---
import type { AdPosicao } from "@prisma/client";
import AdminLayout from "../../layouts/AdminLayout.astro";
import { isAdminAuthenticated } from "../../lib/adminAuth";
import { resizeMonetizationBanner } from "../../lib/bannerResize";
import {
  addAffiliateProduct,
  createAdPlaceholder,
  createInternalAd,
  deleteAdPlaceholder,
  deleteAffiliateProduct,
  deleteInternalAd,
  getTenantByHostname,
  listAdPlaceholdersForTenant,
  listInternalAdsForTenant,
  listInternalAdsStatsByTenant,
  listSites,
  updateAdPlaceholder,
  updateInternalAd,
  updateTenantMonetization
} from "../../lib/cms";
import { isObjectStorageConfigured, uploadPublicImageAsset } from "../../lib/objectStorage";

if (!isAdminAuthenticated(Astro.cookies)) {
  return Astro.redirect("/admin/login");
}

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const action = String(formData.get("action") ?? "");
  const hostname = String(formData.get("hostname") ?? "");

  if (action === "create-internal-ad") {
    const q = `/admin/monetization?hostname=${encodeURIComponent(hostname)}`;
    try {
      const posRaw = String(formData.get("posicao") ?? "");
      if (posRaw !== "topo" && posRaw !== "corpo" && posRaw !== "lateral") {
        throw new Error("Escolha a posição do banner (topo, corpo ou lateral).");
      }
      const posicao = posRaw as AdPosicao;

      const file = formData.get("banner");
      if (!(file instanceof File) || file.size === 0) {
        throw new Error("Selecione uma imagem (PNG, JPG ou WEBP).");
      }
      if (file.size > 12 * 1024 * 1024) {
        throw new Error("Imagem muito grande (máx. 12 MB).");
      }
      if (!/^image\/(png|jpe?g|webp)$/i.test(file.type)) {
        throw new Error("Formato inválido. Use PNG, JPG ou WEBP.");
      }
      if (!isObjectStorageConfigured()) {
        throw new Error("Armazenamento (R2/S3) não configurado no ambiente.");
      }

      const rawBuf = Buffer.from(await file.arrayBuffer());
      const { buffer: resized, contentType } = await resizeMonetizationBanner(rawBuf, posicao);

      const safeHost = hostname.toLowerCase().replace(/[^a-z0-9.-]/g, "-");
      const objectPath = `monetizacao/${safeHost}/${posicao}/${Date.now()}.webp`;
      const imagemUrl = await uploadPublicImageAsset({
        buffer: resized,
        objectPath,
        contentType
      });
      if (!imagemUrl) throw new Error("Falha ao enviar o banner para o storage.");

      const ctaUrl = String(formData.get("ctaUrl") ?? "").trim();
      if (!ctaUrl || !/^https?:\/\//i.test(ctaUrl)) {
        throw new Error("Informe uma URL de destino válida (http/https).");
      }

      const di = String(formData.get("dataInicio") ?? "");
      const df = String(formData.get("dataFim") ?? "");
      const dataInicio = new Date(di);
      const dataFim = new Date(df);
      if (Number.isNaN(dataInicio.getTime()) || Number.isNaN(dataFim.getTime())) {
        throw new Error("Datas de início e fim inválidas.");
      }
      if (dataFim.getTime() < dataInicio.getTime()) {
        throw new Error("A data fim deve ser posterior à data início.");
      }

      await createInternalAd({
        tenantHostname: hostname,
        posicao,
        imagemUrl,
        ctaUrl,
        dataInicio,
        dataFim
      });
      return Astro.redirect(`${q}&ok=1`);
    } catch (e) {
      const msg = e instanceof Error ? e.message : "Erro ao criar anúncio.";
      return Astro.redirect(`${q}&adErr=${encodeURIComponent(msg.slice(0, 400))}`);
    }
  }

  if (action === "delete-internal-ad") {
    const id = Number.parseInt(String(formData.get("adId") ?? ""), 10);
    if (Number.isFinite(id)) {
      await deleteInternalAd(hostname, id);
    }
    return Astro.redirect(`/admin/monetization?hostname=${encodeURIComponent(hostname)}&ok=1`);
  }

  if (action === "update-internal-ad") {
    const q = `/admin/monetization?hostname=${encodeURIComponent(hostname)}`;
    try {
      const adId = Number.parseInt(String(formData.get("adId") ?? ""), 10);
      if (!Number.isFinite(adId)) throw new Error("ID do anúncio inválido.");
      const posRaw = String(formData.get("posicao") ?? "");
      if (posRaw !== "topo" && posRaw !== "corpo" && posRaw !== "lateral") throw new Error("Posição inválida.");
      const posicao = posRaw as AdPosicao;
      const ctaUrl = String(formData.get("ctaUrl") ?? "").trim();
      if (!ctaUrl || !/^https?:\/\//i.test(ctaUrl)) throw new Error("URL de destino inválida.");
      const di = String(formData.get("dataInicio") ?? "");
      const df = String(formData.get("dataFim") ?? "");
      const dataInicio = new Date(di);
      const dataFim = new Date(df);
      if (Number.isNaN(dataInicio.getTime()) || Number.isNaN(dataFim.getTime())) throw new Error("Datas inválidas.");
      if (dataFim.getTime() < dataInicio.getTime()) throw new Error("A data fim deve ser posterior à início.");

      let imagemUrl: string | undefined;
      const file = formData.get("banner");
      if (file instanceof File && file.size > 0) {
        if (file.size > 12 * 1024 * 1024) throw new Error("Imagem muito grande (máx. 12 MB).");
        if (!/^image\/(png|jpe?g|webp)$/i.test(file.type)) throw new Error("Formato de imagem inválido.");
        if (!isObjectStorageConfigured()) throw new Error("Storage não configurado.");
        const rawBuf = Buffer.from(await file.arrayBuffer());
        const { buffer: resized, contentType } = await resizeMonetizationBanner(rawBuf, posicao);
        const safeHost = hostname.toLowerCase().replace(/[^a-z0-9.-]/g, "-");
        const objectPath = `monetizacao/${safeHost}/${posicao}/${Date.now()}.webp`;
        const up = await uploadPublicImageAsset({ buffer: resized, objectPath, contentType });
        if (!up) throw new Error("Falha no upload da nova imagem.");
        imagemUrl = up;
      }

      await updateInternalAd(hostname, adId, {
        posicao,
        ctaUrl,
        dataInicio,
        dataFim,
        ...(imagemUrl !== undefined && { imagemUrl })
      });
      return Astro.redirect(`${q}&ok=1`);
    } catch (e) {
      const msg = e instanceof Error ? e.message : "Erro ao atualizar.";
      return Astro.redirect(`${q}&adErr=${encodeURIComponent(msg.slice(0, 400))}`);
    }
  }

  if (action === "create-placeholder") {
    const q = `/admin/monetization?hostname=${encodeURIComponent(hostname)}`;
    try {
      const posRaw = String(formData.get("posicao") ?? "");
      if (posRaw !== "topo" && posRaw !== "corpo" && posRaw !== "lateral") throw new Error("Posição inválida.");
      const posicao = posRaw as AdPosicao;
      const titulo = String(formData.get("titulo") ?? "").trim();
      if (!titulo) throw new Error("Informe o título do modelo (ex.: Meus produtos e serviços).");
      const ctaRaw = String(formData.get("ctaUrl") ?? "").trim();
      const ctaUrl = ctaRaw && /^https?:\/\//i.test(ctaRaw) ? ctaRaw : null;
      const sortOrder = Number.parseInt(String(formData.get("sortOrder") ?? "0"), 10) || 0;
      const file = formData.get("banner");
      if (!(file instanceof File) || file.size === 0) throw new Error("Selecione a imagem do placeholder.");
      if (!isObjectStorageConfigured()) throw new Error("Storage não configurado.");
      const rawBuf = Buffer.from(await file.arrayBuffer());
      const { buffer: resized, contentType } = await resizeMonetizationBanner(rawBuf, posicao);
      const safeHost = hostname.toLowerCase().replace(/[^a-z0-9.-]/g, "-");
      const objectPath = `monetizacao/${safeHost}/placeholder/${posicao}/${Date.now()}.webp`;
      const imagemUrl = await uploadPublicImageAsset({ buffer: resized, objectPath, contentType });
      if (!imagemUrl) throw new Error("Falha no upload.");
      await createAdPlaceholder({
        tenantHostname: hostname,
        posicao,
        titulo,
        imagemUrl,
        ctaUrl,
        sortOrder
      });
      return Astro.redirect(`${q}&ok=1`);
    } catch (e) {
      const msg = e instanceof Error ? e.message : "Erro ao criar placeholder.";
      return Astro.redirect(`${q}&adErr=${encodeURIComponent(msg.slice(0, 400))}`);
    }
  }

  if (action === "update-placeholder") {
    const q = `/admin/monetization?hostname=${encodeURIComponent(hostname)}`;
    try {
      const phId = Number.parseInt(String(formData.get("placeholderId") ?? ""), 10);
      if (!Number.isFinite(phId)) throw new Error("ID inválido.");
      const posRaw = String(formData.get("posicao") ?? "");
      if (posRaw !== "topo" && posRaw !== "corpo" && posRaw !== "lateral") throw new Error("Posição inválida.");
      const posicao = posRaw as AdPosicao;
      const titulo = String(formData.get("titulo") ?? "").trim();
      if (!titulo) throw new Error("Título obrigatório.");
      const ctaRaw = String(formData.get("ctaUrl") ?? "").trim();
      const ctaUrl = ctaRaw === "" ? null : ctaRaw;
      if (ctaUrl && !/^https?:\/\//i.test(ctaUrl)) throw new Error("URL opcional deve ser http(s).");
      const sortOrder = Number.parseInt(String(formData.get("sortOrder") ?? "0"), 10) || 0;

      let imagemUrl: string | undefined;
      const file = formData.get("banner");
      if (file instanceof File && file.size > 0) {
        if (!isObjectStorageConfigured()) throw new Error("Storage não configurado.");
        const rawBuf = Buffer.from(await file.arrayBuffer());
        const { buffer: resized, contentType } = await resizeMonetizationBanner(rawBuf, posicao);
        const safeHost = hostname.toLowerCase().replace(/[^a-z0-9.-]/g, "-");
        const objectPath = `monetizacao/${safeHost}/placeholder/${posicao}/${Date.now()}.webp`;
        const up = await uploadPublicImageAsset({ buffer: resized, objectPath, contentType });
        if (!up) throw new Error("Falha no upload.");
        imagemUrl = up;
      }

      await updateAdPlaceholder(hostname, phId, {
        posicao,
        titulo,
        ctaUrl,
        sortOrder,
        ...(imagemUrl !== undefined && { imagemUrl })
      });
      return Astro.redirect(`${q}&ok=1`);
    } catch (e) {
      const msg = e instanceof Error ? e.message : "Erro ao atualizar placeholder.";
      return Astro.redirect(`${q}&adErr=${encodeURIComponent(msg.slice(0, 400))}`);
    }
  }

  if (action === "delete-placeholder") {
    const id = Number.parseInt(String(formData.get("placeholderId") ?? ""), 10);
    if (Number.isFinite(id)) await deleteAdPlaceholder(hostname, id);
    return Astro.redirect(`/admin/monetization?hostname=${encodeURIComponent(hostname)}&ok=1`);
  }

  if (action === "save-monetization") {
    await updateTenantMonetization({
      hostname,
      amazonEnabled: String(formData.get("amazonEnabled") ?? "") === "on",
      affiliateTrackingId: String(formData.get("affiliateTrackingId") ?? "")
    });
    return Astro.redirect(`/admin/monetization?hostname=${encodeURIComponent(hostname)}&ok=1`);
  }

  if (action === "add-product") {
    await addAffiliateProduct(hostname, {
      title: String(formData.get("title") ?? ""),
      cta: String(formData.get("cta") ?? "Ver oferta"),
      url: String(formData.get("url") ?? "")
    });
    return Astro.redirect(`/admin/monetization?hostname=${encodeURIComponent(hostname)}&ok=1`);
  }

  if (action === "delete-product") {
    await deleteAffiliateProduct(hostname, String(formData.get("productId") ?? ""));
    return Astro.redirect(`/admin/monetization?hostname=${encodeURIComponent(hostname)}&ok=1`);
  }
}

const sites = await listSites();
const selected = new URL(Astro.request.url).searchParams.get("hostname") ?? sites[0]?.hostname ?? "";
const tenant = selected ? await getTenantByHostname(selected) : null;
const saved = new URL(Astro.request.url).searchParams.get("ok") === "1";
const adErr = new URL(Astro.request.url).searchParams.get("adErr");
const internalAdsStats = await listInternalAdsStatsByTenant();
const internalAds = tenant ? await listInternalAdsForTenant(tenant.hostname) : [];
const placeholders = tenant ? await listAdPlaceholdersForTenant(tenant.hostname) : [];

function fmtDT(d: Date) {
  const pad = (n: number) => String(n).padStart(2, "0");
  return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
}
const defaultInicio = fmtDT(new Date());
const defaultFim = fmtDT(new Date(Date.now() + 30 * 24 * 60 * 60 * 1000));
---

<AdminLayout title="Monetização | IAE Blog Factory">
  {saved && <p class="mb-4 rounded-lg bg-emerald-100 px-3 py-2 text-sm text-emerald-900">Dados salvos.</p>}
  {adErr && (
    <p class="mb-4 rounded-lg bg-rose-100 px-3 py-2 text-sm text-rose-900">
      {adErr}
    </p>
  )}

  <section class="rounded-2xl bg-white p-5 shadow-sm">
    <h2 class="text-lg font-semibold">Relatório — anúncios proprietários</h2>
    <p class="mt-1 text-sm text-slate-600">Totais de cliques e impressões por tenant (todos os banners internos).</p>
    {internalAdsStats.length === 0 ? (
      <p class="mt-3 text-sm text-slate-500">Nenhum anúncio cadastrado ainda.</p>
    ) : (
      <div class="mt-4 overflow-x-auto">
        <table class="min-w-full text-left text-sm">
          <thead>
            <tr class="border-b border-slate-200 text-slate-600">
              <th class="py-2 pr-4 font-medium">Tenant</th>
              <th class="py-2 pr-4 font-medium">Cliques</th>
              <th class="py-2 font-medium">Impressões</th>
            </tr>
          </thead>
          <tbody>
            {internalAdsStats.map((row) => (
              <tr class="border-b border-slate-100">
                <td class="py-2 pr-4">{row.tenantHostname}</td>
                <td class="py-2 pr-4">{row.cliques}</td>
                <td class="py-2">{row.impressoes}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </section>

  <section class="mt-6 rounded-2xl bg-white p-5 shadow-sm">
    <form method="GET" class="flex flex-wrap items-end gap-3">
      <label class="text-sm">
        <span class="mb-1 block font-medium">Tenant</span>
        <select class="rounded-lg border border-slate-300 px-3 py-2" name="hostname">
          {sites.map((site) => (
            <option value={site.hostname} selected={site.hostname === selected}>
              {site.hostname}
            </option>
          ))}
        </select>
      </label>
      <button class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white" type="submit">Abrir</button>
    </form>
  </section>

  {tenant && (
    <>
      <section class="mt-6 rounded-2xl bg-white p-5 shadow-sm">
        <h2 class="text-xl font-semibold">Banners proprietários (R2)</h2>
        <p class="mt-1 text-sm text-slate-600">
          Escolha o espaço no layout, envie a arte e defina o período. Imagens são redimensionadas automaticamente (728×110 topo/corpo,
          300×250 lateral) e enviadas para o mesmo bucket já usado pelo blog. O site exibe <strong>dois</strong> banners de corpo e <strong>três</strong> na lateral (empilhados); com vários anúncios ativos na mesma posição, eles alternam por slot.
        </p>

        <div class="mt-6 grid gap-6 lg:grid-cols-2">
          <div>
            <p class="mb-2 text-xs font-medium uppercase tracking-wide text-slate-500">Mapa do layout</p>
            <div class="space-y-2 rounded-xl border border-slate-200 bg-slate-50 p-4">
              <div class="rounded border border-dashed border-slate-300 bg-white py-3 text-center text-xs text-slate-500">
                Faixa topo (728×110)
              </div>
              <div class="flex gap-2">
                <div class="min-h-[120px] flex-1 space-y-1 rounded border border-dashed border-slate-300 bg-white p-2 text-xs text-slate-500">
                  <p>Conteúdo do artigo</p>
                  <div class="rounded border border-slate-200 bg-slate-50 py-1.5 text-center text-[10px]">Corpo 728×110</div>
                  <div class="rounded border border-slate-200 bg-slate-50 py-1.5 text-center text-[10px]">Corpo 728×110</div>
                </div>
                <div class="flex w-28 shrink-0 flex-col gap-1">
                  <div class="flex-1 rounded border border-dashed border-slate-300 bg-white py-2 text-center text-[9px] leading-tight text-slate-500">
                    Lateral 1<br />300×250
                  </div>
                  <div class="flex-1 rounded border border-dashed border-slate-300 bg-white py-2 text-center text-[9px] leading-tight text-slate-500">
                    Lateral 2
                  </div>
                  <div class="flex-1 rounded border border-dashed border-slate-300 bg-white py-2 text-center text-[9px] leading-tight text-slate-500">
                    Lateral 3
                  </div>
                </div>
              </div>
              <div class="rounded border border-dashed border-slate-300 bg-white py-2 text-center text-xs text-slate-500">
                Corpo extra (728×110) — também após blocos longos na home
              </div>
            </div>
          </div>

          <div>
            <form method="POST" enctype="multipart/form-data" class="grid gap-3">
              <input type="hidden" name="action" value="create-internal-ad" />
              <input type="hidden" name="hostname" value={tenant.hostname} />

              <fieldset class="grid gap-2">
                <legend class="text-sm font-medium">Posição do slot</legend>
                <label class="flex cursor-pointer items-start gap-3 rounded-lg border border-slate-200 p-3 has-[:checked]:border-indigo-500 has-[:checked]:bg-indigo-50">
                  <input type="radio" name="posicao" value="topo" class="mt-1" checked />
                  <span>
                    <span class="font-medium">Topo</span>
                    <span class="block text-xs text-slate-600">728 × 110 px</span>
                  </span>
                </label>
                <label class="flex cursor-pointer items-start gap-3 rounded-lg border border-slate-200 p-3 has-[:checked]:border-indigo-500 has-[:checked]:bg-indigo-50">
                  <input type="radio" name="posicao" value="corpo" class="mt-1" />
                  <span>
                    <span class="font-medium">Corpo</span>
                    <span class="block text-xs text-slate-600">728 × 110 px (2 slots no layout)</span>
                  </span>
                </label>
                <label class="flex cursor-pointer items-start gap-3 rounded-lg border border-slate-200 p-3 has-[:checked]:border-indigo-500 has-[:checked]:bg-indigo-50">
                  <input type="radio" name="posicao" value="lateral" class="mt-1" />
                  <span>
                    <span class="font-medium">Lateral</span>
                    <span class="block text-xs text-slate-600">300 × 250 px (3 slots empilhados)</span>
                  </span>
                </label>
              </fieldset>

              <label class="text-sm">
                <span class="mb-1 block font-medium">Imagem do banner</span>
                <input
                  type="file"
                  name="banner"
                  accept="image/png,image/jpeg,image/webp"
                  class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm file:mr-3"
                  required
                />
              </label>
              <label class="text-sm">
                <span class="mb-1 block font-medium">URL de destino (CTA)</span>
                <input
                  type="url"
                  name="ctaUrl"
                  class="w-full rounded-lg border border-slate-300 px-3 py-2"
                  placeholder="https://"
                  required
                />
              </label>
              <div class="grid gap-3 sm:grid-cols-2">
                <label class="text-sm">
                  <span class="mb-1 block font-medium">Início</span>
                  <input type="datetime-local" name="dataInicio" class="w-full rounded-lg border border-slate-300 px-3 py-2" value={defaultInicio} required />
                </label>
                <label class="text-sm">
                  <span class="mb-1 block font-medium">Fim</span>
                  <input type="datetime-local" name="dataFim" class="w-full rounded-lg border border-slate-300 px-3 py-2" value={defaultFim} required />
                </label>
              </div>
              <button class="rounded-lg bg-indigo-600 px-4 py-2 font-semibold text-white" type="submit">
                Publicar banner
              </button>
            </form>
          </div>
        </div>

        <div class="mt-8">
          <h3 class="text-base font-semibold">Banners deste tenant</h3>
          {internalAds.length === 0 ? (
            <p class="mt-2 text-sm text-slate-500">Nenhum banner interno ainda.</p>
          ) : (
            <ul class="mt-3 space-y-4">
              {internalAds.map((ad) => (
                <li class="rounded-lg border border-slate-200 p-3">
                  <div class="flex flex-wrap items-start gap-4">
                    <img src={ad.imagemUrl} alt="" class="h-16 max-w-[200px] rounded border border-slate-100 object-cover" loading="lazy" />
                    <div class="min-w-0 flex-1 text-sm">
                      <p class="font-medium capitalize">{ad.posicao}</p>
                      <p class="truncate text-xs text-slate-600">{ad.ctaUrl}</p>
                      <p class="mt-1 text-xs text-slate-500">
                        {ad.dataInicio.toLocaleString("pt-BR")} — {ad.dataFim.toLocaleString("pt-BR")}
                      </p>
                      <p class="text-xs text-slate-500">
                        Cliques: {ad.cliques} · Impressões: {ad.impressoes}
                      </p>
                    </div>
                    <form method="POST" class="shrink-0">
                      <input type="hidden" name="action" value="delete-internal-ad" />
                      <input type="hidden" name="hostname" value={tenant.hostname} />
                      <input type="hidden" name="adId" value={String(ad.id)} />
                      <button class="rounded-lg bg-rose-700 px-3 py-1.5 text-sm text-white" type="submit">
                        Excluir
                      </button>
                    </form>
                  </div>
                  <details class="mt-3 border-t border-slate-100 pt-3">
                    <summary class="cursor-pointer text-sm font-medium text-indigo-600">Editar anúncio</summary>
                    <form method="POST" enctype="multipart/form-data" class="mt-3 grid gap-2 sm:grid-cols-2">
                      <input type="hidden" name="action" value="update-internal-ad" />
                      <input type="hidden" name="hostname" value={tenant.hostname} />
                      <input type="hidden" name="adId" value={String(ad.id)} />
                      <fieldset class="sm:col-span-2 grid gap-2">
                        <legend class="text-xs font-medium text-slate-600">Posição</legend>
                        <label class="flex items-center gap-2 text-sm">
                          <input type="radio" name="posicao" value="topo" checked={ad.posicao === "topo"} />
                          Topo
                        </label>
                        <label class="flex items-center gap-2 text-sm">
                          <input type="radio" name="posicao" value="corpo" checked={ad.posicao === "corpo"} />
                          Corpo
                        </label>
                        <label class="flex items-center gap-2 text-sm">
                          <input type="radio" name="posicao" value="lateral" checked={ad.posicao === "lateral"} />
                          Lateral
                        </label>
                      </fieldset>
                      <label class="text-sm sm:col-span-2">
                        <span class="mb-1 block">Nova imagem (opcional)</span>
                        <input type="file" name="banner" accept="image/png,image/jpeg,image/webp" class="w-full text-sm" />
                      </label>
                      <label class="text-sm sm:col-span-2">
                        <span class="mb-1 block">URL de destino</span>
                        <input type="url" name="ctaUrl" class="w-full rounded-lg border border-slate-300 px-3 py-2" value={ad.ctaUrl} required />
                      </label>
                      <label class="text-sm">
                        <span class="mb-1 block">Início</span>
                        <input type="datetime-local" name="dataInicio" class="w-full rounded-lg border border-slate-300 px-3 py-2" value={fmtDT(ad.dataInicio)} required />
                      </label>
                      <label class="text-sm">
                        <span class="mb-1 block">Fim</span>
                        <input type="datetime-local" name="dataFim" class="w-full rounded-lg border border-slate-300 px-3 py-2" value={fmtDT(ad.dataFim)} required />
                      </label>
                      <button class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white sm:col-span-2" type="submit">
                        Salvar alterações
                      </button>
                    </form>
                  </details>
                </li>
              ))}
            </ul>
          )}
        </div>
      </section>

      <section class="mt-6 rounded-2xl bg-white p-5 shadow-sm">
        <h2 class="text-xl font-semibold">Placeholders (quando não há anúncio pago)</h2>
        <p class="mt-1 text-sm text-slate-600">
          Cadastre um ou mais <strong>modelos</strong> por posição (ex.: “Meus produtos e serviços”). Quando o slot está vazio, o site escolhe um modelo conforme o índice do slot (entre os da mesma posição).
          Mesmos tamanhos dos banners (728×110 ou 300×250). Link (CTA) é opcional.
        </p>

        <form method="POST" enctype="multipart/form-data" class="mt-4 grid gap-3 border-b border-slate-200 pb-6 md:grid-cols-2">
          <input type="hidden" name="action" value="create-placeholder" />
          <input type="hidden" name="hostname" value={tenant.hostname} />
          <label class="text-sm md:col-span-2">
            <span class="mb-1 block font-medium">Título do modelo</span>
            <input class="w-full rounded-lg border border-slate-300 px-3 py-2" name="titulo" placeholder="Ex.: Meus produtos e serviços" required />
          </label>
          <fieldset class="md:col-span-2 grid gap-2">
            <legend class="text-sm font-medium">Posição</legend>
            <label class="flex items-center gap-2 text-sm">
              <input type="radio" name="posicao" value="topo" class="mt-0.5" checked />
              Topo (728×110)
            </label>
            <label class="flex items-center gap-2 text-sm">
              <input type="radio" name="posicao" value="corpo" class="mt-0.5" />
              Corpo (728×110)
            </label>
            <label class="flex items-center gap-2 text-sm">
              <input type="radio" name="posicao" value="lateral" class="mt-0.5" />
              Lateral (300×250)
            </label>
          </fieldset>
          <label class="text-sm md:col-span-2">
            <span class="mb-1 block font-medium">Imagem</span>
            <input type="file" name="banner" accept="image/png,image/jpeg,image/webp" class="w-full text-sm" required />
          </label>
          <label class="text-sm md:col-span-2">
            <span class="mb-1 block">Link opcional (CTA)</span>
            <input type="url" name="ctaUrl" class="w-full rounded-lg border border-slate-300 px-3 py-2" placeholder="https:// (opcional)" />
          </label>
          <label class="text-sm">
            <span class="mb-1 block">Ordem (menor = primeiro na lista admin)</span>
            <input type="number" name="sortOrder" class="w-full rounded-lg border border-slate-300 px-3 py-2" value="0" />
          </label>
          <div class="md:col-span-2">
            <button class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white" type="submit">
              Adicionar placeholder
            </button>
          </div>
        </form>

        <h3 class="mt-4 text-base font-semibold">Modelos cadastrados</h3>
        {placeholders.length === 0 ? (
          <p class="mt-2 text-sm text-slate-500">Nenhum placeholder ainda.</p>
        ) : (
          <ul class="mt-3 space-y-4">
            {placeholders.map((ph) => (
              <li class="rounded-lg border border-slate-200 p-3">
                <div class="flex flex-wrap items-start gap-3">
                  <img src={ph.imagemUrl} alt="" class="h-16 max-w-[200px] rounded object-cover" loading="lazy" />
                  <div class="min-w-0 flex-1 text-sm">
                    <p class="font-medium">{ph.titulo}</p>
                    <p class="text-xs capitalize text-slate-600">{ph.posicao}</p>
                    {ph.ctaUrl && <p class="truncate text-xs text-slate-500">{ph.ctaUrl}</p>}
                    <p class="text-xs text-slate-400">Ordem: {ph.sortOrder}</p>
                  </div>
                  <form method="POST">
                    <input type="hidden" name="action" value="delete-placeholder" />
                    <input type="hidden" name="hostname" value={tenant.hostname} />
                    <input type="hidden" name="placeholderId" value={String(ph.id)} />
                    <button class="rounded-lg bg-rose-700 px-3 py-1.5 text-sm text-white" type="submit">
                      Excluir
                    </button>
                  </form>
                </div>
                <details class="mt-3 border-t border-slate-100 pt-3">
                  <summary class="cursor-pointer text-sm font-medium text-indigo-600">Editar placeholder</summary>
                  <form method="POST" enctype="multipart/form-data" class="mt-3 grid gap-2 sm:grid-cols-2">
                    <input type="hidden" name="action" value="update-placeholder" />
                    <input type="hidden" name="hostname" value={tenant.hostname} />
                    <input type="hidden" name="placeholderId" value={String(ph.id)} />
                    <label class="text-sm sm:col-span-2">
                      <span class="mb-1 block">Título</span>
                      <input name="titulo" class="w-full rounded-lg border border-slate-300 px-3 py-2" value={ph.titulo} required />
                    </label>
                    <fieldset class="sm:col-span-2 grid gap-2">
                      <legend class="text-xs text-slate-600">Posição</legend>
                      <label class="flex items-center gap-2 text-sm">
                        <input type="radio" name="posicao" value="topo" checked={ph.posicao === "topo"} />
                        Topo
                      </label>
                      <label class="flex items-center gap-2 text-sm">
                        <input type="radio" name="posicao" value="corpo" checked={ph.posicao === "corpo"} />
                        Corpo
                      </label>
                      <label class="flex items-center gap-2 text-sm">
                        <input type="radio" name="posicao" value="lateral" checked={ph.posicao === "lateral"} />
                        Lateral
                      </label>
                    </fieldset>
                    <label class="text-sm sm:col-span-2">
                      <span class="mb-1 block">Nova imagem (opcional)</span>
                      <input type="file" name="banner" accept="image/png,image/jpeg,image/webp" class="w-full text-sm" />
                    </label>
                    <label class="text-sm sm:col-span-2">
                      <span class="mb-1 block">Link (opcional)</span>
                      <input type="url" name="ctaUrl" class="w-full rounded-lg border border-slate-300 px-3 py-2" value={ph.ctaUrl ?? ""} />
                    </label>
                    <label class="text-sm">
                      <span class="mb-1 block">Ordem</span>
                      <input type="number" name="sortOrder" class="w-full rounded-lg border border-slate-300 px-3 py-2" value={ph.sortOrder} />
                    </label>
                    <button class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white sm:col-span-2" type="submit">
                      Salvar placeholder
                    </button>
                  </form>
                </details>
              </li>
            ))}
          </ul>
        )}
      </section>

      <section class="mt-6 rounded-2xl bg-white p-5 shadow-sm">
        <h2 class="text-xl font-semibold">Amazon Afiliados</h2>
        <form method="POST" class="mt-4 grid gap-3 md:grid-cols-2">
          <input type="hidden" name="action" value="save-monetization" />
          <input type="hidden" name="hostname" value={tenant.hostname} />

          <label class="text-sm md:col-span-2">
            <input type="checkbox" name="amazonEnabled" checked={tenant.affiliate.enabled} />
            <span class="ml-2">Habilitar Amazon afiliados</span>
          </label>
          <label class="text-sm md:col-span-2">
            <span class="mb-1 block">Tracking ID Amazon</span>
            <input
              class="w-full rounded-lg border border-slate-300 px-3 py-2"
              name="affiliateTrackingId"
              value={tenant.affiliate.trackingId}
            />
          </label>

          <button class="rounded-lg bg-indigo-600 px-4 py-2 font-semibold text-white md:col-span-2" type="submit">
            Salvar monetização
          </button>
        </form>
      </section>

      <section class="mt-6 rounded-2xl bg-white p-5 shadow-sm">
        <h3 class="text-lg font-semibold">Produtos Amazon (links completos ou amzn.to)</h3>
        <form method="POST" class="mt-4 grid gap-3 md:grid-cols-2">
          <input type="hidden" name="action" value="add-product" />
          <input type="hidden" name="hostname" value={tenant.hostname} />
          <input class="rounded-lg border border-slate-300 px-3 py-2" name="title" placeholder="Nome do produto" required />
          <input class="rounded-lg border border-slate-300 px-3 py-2" name="cta" placeholder="CTA (ex: Ver oferta)" value="Ver oferta" />
          <input class="rounded-lg border border-slate-300 px-3 py-2 md:col-span-2" name="url" placeholder="https://www.amazon.com.br/... ou https://amzn.to/..." required />
          <button class="rounded-lg bg-slate-900 px-4 py-2 text-white md:col-span-2" type="submit">Adicionar produto</button>
        </form>

        <ul class="mt-4 space-y-2">
          {tenant.affiliate.products.map((product) => (
            <li class="flex flex-wrap items-center justify-between gap-2 rounded-lg border border-slate-200 p-3">
              <div>
                <p class="font-medium">{product.title}</p>
                <p class="text-xs text-slate-500">{product.url}</p>
              </div>
              <form method="POST">
                <input type="hidden" name="action" value="delete-product" />
                <input type="hidden" name="hostname" value={tenant.hostname} />
                <input type="hidden" name="productId" value={product.id} />
                <button class="rounded-lg bg-rose-700 px-3 py-1.5 text-sm text-white" type="submit">Remover</button>
              </form>
            </li>
          ))}
        </ul>
      </section>
    </>
  )}
</AdminLayout>
