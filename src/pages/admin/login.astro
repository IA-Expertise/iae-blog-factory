---
import {
  getStaffSession,
  setAdminSession,
  setEditorSession,
  validateAdminLogin,
  validateEditorLogin
} from "../../lib/adminAuth";

const nextRaw = new URL(Astro.request.url).searchParams.get("next") ?? "";
const nextPath = nextRaw.startsWith("/") && !nextRaw.startsWith("//") ? nextRaw : "";

const session = getStaffSession(Astro.cookies);
if (session?.role === "admin") {
  return Astro.redirect(nextPath || "/admin");
}
if (session?.role === "editor") {
  return Astro.redirect(nextPath.startsWith("/campo") ? nextPath : "/campo");
}

let error = "";

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const username = String(formData.get("username") ?? "");
  const password = String(formData.get("password") ?? "");
  const nextFromForm = String(formData.get("next") ?? nextPath);
  const safeNext =
    nextFromForm.startsWith("/") && !nextFromForm.startsWith("//") ? nextFromForm : "";

  if (validateAdminLogin(username, password)) {
    setAdminSession(Astro.cookies);
    return Astro.redirect(safeNext || "/admin");
  }

  const editor = await validateEditorLogin(username, password);
  if (editor) {
    setEditorSession(Astro.cookies, editor);
    const dest = safeNext.startsWith("/campo") ? safeNext : "/campo";
    return Astro.redirect(dest);
  }

  error = "Usuario ou senha invalidos.";
}
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login | IAE Blog Factory</title>
  </head>
  <body class="relative grid min-h-screen place-items-center overflow-hidden bg-slate-950 px-4 text-slate-100">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_20%_20%,rgba(79,70,229,0.35),transparent_45%),radial-gradient(circle_at_80%_0%,rgba(14,165,233,0.2),transparent_40%)]"></div>
    <main class="relative w-full max-w-md rounded-3xl border border-slate-700/70 bg-slate-900/90 p-7 shadow-2xl backdrop-blur">
      <p class="inline-flex rounded-full border border-indigo-400/40 bg-indigo-500/20 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-indigo-200">
        Acesso
      </p>
      <h1 class="mt-4 text-3xl font-bold leading-tight">Entrar</h1>
      <p class="mt-2 text-sm text-slate-300">
        Admin IAE ou editor do Campo (cliente). Use o usuário e a senha que recebeu.
      </p>

      {error && <p class="mt-4 rounded-lg bg-rose-900/40 px-3 py-2 text-sm text-rose-300">{error}</p>}

      <form method="POST" class="mt-6 space-y-4">
        <input type="hidden" name="next" value={nextPath} />
        <label class="block text-sm">
          <span class="mb-1 block text-slate-300">Usuario</span>
          <input
            name="username"
            type="text"
            required
            autocomplete="username"
            class="w-full rounded-xl border border-slate-700 bg-slate-950/90 px-3 py-2.5 outline-none ring-indigo-500 transition focus:border-indigo-400 focus:ring"
            placeholder="seu usuario"
          />
        </label>

        <label class="block text-sm">
          <span class="mb-1 block text-slate-300">Senha</span>
          <input
            name="password"
            type="password"
            required
            autocomplete="current-password"
            class="w-full rounded-xl border border-slate-700 bg-slate-950/90 px-3 py-2.5 outline-none ring-indigo-500 transition focus:border-indigo-400 focus:ring"
            placeholder="********"
          />
        </label>

        <button
          type="submit"
          class="w-full rounded-xl bg-gradient-to-r from-indigo-600 to-cyan-500 px-4 py-2.5 font-semibold text-white transition hover:brightness-110"
        >
          Entrar
        </button>
      </form>

      <p class="mt-4 text-center text-xs text-slate-400">Ambiente restrito. Clientes acessam apenas o Campo do seu blog.</p>
    </main>
  </body>
</html>
