generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                 String             @id @default(cuid())
  hostname           String             @unique
  brandName          String
  niche              String
  heroTitle          String
  heroSubtitle       String
  heroCtaLabel       String
  heroCtaHref        String
  heroImage          String
  themePrimary       String
  themeSecondary     String
  themeAccent        String
  themeBackground    String
  themeSurface       String
  themeText          String
  themeHeadingFont   String
  themeBodyFont      String
  adProvider         String             @default("adsense")
  adsEnabled         Boolean            @default(true)
  adClient           String
  adTopSlot          String
  adSidebarSlot      String
  adInContentSlot    String
  adFooterSlot       String
  amazonEnabled      Boolean            @default(true)
  affiliateNetwork   String
  affiliateTrackingId String
  logoUrl             String?
  /// Arte da testeira (ex.: 1920×320), URL pública após upload.
  headerArtUrl        String?
  rssFeedUrl          String?
  /// Exibir caixa “Feed RSS” na home pública (`/t/...`). A URL continua disponível para o gerador quando preenchida.
  showRssHomePromo    Boolean            @default(true)
  themePreset         String             @default("classic")
  projectDescription  String?
  editorialStyleNotes String?
  targetAudience      String?
  defaultArticleTone  String             @default("profissional")
  socialInstagram     String?
  socialFacebook      String?
  socialYoutube       String?
  footerContactText   String?
  menuContactText     String?
  autoPublishWeekdays String?
  autoPublishHourUtc  Int?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  posts              Post[]
  comments           Comment[]
  affiliateProducts  AffiliateProduct[]
  generationJobs     GenerationJob[]
  articlePitches     ArticlePitch[]
  ads                Ad[]
  adPlaceholders     AdPlaceholder[]
}

/// Anúncios proprietários (monetização interna), filtrados pelo hostname do tenant.
model Ad {
  id               Int        @id @default(autoincrement())
  /// Hostname do blog (igual a `Tenant.hostname`).
  tenantHostname   String
  tenant           Tenant     @relation(fields: [tenantHostname], references: [hostname], onDelete: Cascade)
  posicao          AdPosicao
  imagemUrl        String
  ctaUrl           String
  dataInicio       DateTime
  dataFim          DateTime
  cliques          Int        @default(0)
  impressoes       Int        @default(0)

  @@index([tenantHostname, posicao])
  @@index([dataInicio, dataFim])
  @@map("Ads")
}

enum AdPosicao {
  topo
  corpo
  lateral
}

/// Placeholders quando não há anúncio pago no slot (vários modelos por posição, ex.: “Meus produtos”).
model AdPlaceholder {
  id             Int        @id @default(autoincrement())
  tenantHostname String
  tenant         Tenant     @relation(fields: [tenantHostname], references: [hostname], onDelete: Cascade)
  posicao        AdPosicao
  titulo         String
  imagemUrl      String
  ctaUrl         String?
  sortOrder      Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([tenantHostname, posicao])
  @@map("AdPlaceholders")
}

model ArticlePitch {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  monthKey    String
  title       String
  summary     String
  status      String   @default("SUGGESTED")
  postId      String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, monthKey])
  @@index([status])
}

model Post {
  id                 String    @id @default(cuid())
  tenantId           String
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title              String
  slug               String
  category           String
  image              String
  excerpt            String?
  content            String?
  status             String    @default("DRAFT")
  scheduledPublishAt DateTime?
  createdAt          DateTime  @default(now())
  publishedAt        DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  comments           Comment[]

  @@index([tenantId])
  @@index([status])
  @@index([scheduledPublishAt])
}

model Comment {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  postId      String
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorName  String
  authorEmail String?
  content     String
  status      String   @default("PUBLISHED")
  source      String   @default("PUBLIC_FORM")
  consentGiven Boolean @default(false)
  ipHash      String?
  userAgent   String?
  isFlagged   Boolean  @default(false)
  flagReason  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, status, createdAt])
  @@index([postId, createdAt])
}

model AffiliateProduct {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title    String
  cta      String
  url      String

  @@index([tenantId])
}

model GenerationJob {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  keyword     String
  tone        String
  status      String
  resultTitle String?
  resultSlug  String?
  resultImage String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
}
